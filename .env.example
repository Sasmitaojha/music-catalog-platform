# Backend (Spring Boot)
# JWT secret - must be at least 32 characters in production
APP_JWT_SECRET=change_this_to_a_long_secure_secret_phrase_32_chars_min
APP_JWT_EXPIRATION_MS=86400000

# Spring datasource for production (Postgres)
# Example: jdbc:postgresql://HOST:5432/DBNAME
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/your_db_name
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Backend server port (optional)
SERVER_PORT=8080

# Optional OpenAI / Gemini key for AI features
OPENAI_API_KEY=

# Frontend
# Set this to your backend base API URL (include /api suffix if desired)
# This value is used at build time by Vite and also passed into the Docker build via docker-compose.
VITE_API_URL=https://your-backend-url/api
